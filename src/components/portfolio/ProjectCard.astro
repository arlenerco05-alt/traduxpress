---
interface Props {
  title: string;
  category: string;
  alt: string;
  href: string;
  available: boolean;
  actionLabel: string;
  previewLabel: string;
  upcomingLabel: string;
  previewImage?: string;
}

const {
  title,
  category,
  alt,
  href,
  available,
  actionLabel,
  previewLabel,
  upcomingLabel,
  previewImage,
} = Astro.props;
---

{available ? (
  <a class="project-card__link group" href={href}>
    <article class="project-card">
      <figure class="project-card__figure">
        {previewImage ? (
          <img src={previewImage} alt={alt} loading="lazy" />
        ) : (
          <div class="project-card__placeholder">
            <span class="project-card__placeholder-label">TraduXpress · Portfolio</span>
            <span class="project-card__placeholder-title">{title}</span>
            <span class="project-card__placeholder-note">{previewLabel}</span>
          </div>
        )}
        <figcaption class="project-card__overlay">
          <div class="min-w-0">
            <span class="project-card__category">{category}</span>
            <h3 class="project-card__title">{title}</h3>
            <span class="project-card__action">{actionLabel} <span aria-hidden="true">↗</span></span>
          </div>
        </figcaption>
      </figure>
    </article>
  </a>
) : (
  <article class="project-card project-card--upcoming" aria-disabled="true">
    <figure class="project-card__figure">
      <div class="project-card__placeholder project-card__placeholder--upcoming">
        <span class="project-card__placeholder-label">TraduXpress · Portfolio</span>
        <span class="project-card__placeholder-title">{title}</span>
      </div>
      <figcaption class="project-card__overlay">
        <div class="min-w-0">
          <span class="project-card__category">{category}</span>
          <h3 class="project-card__title">{title}</h3>
        </div>
        <span class="project-card__status">{upcomingLabel}</span>
      </figcaption>
    </figure>
  </article>
)}

<style>
  .project-card {
    min-width: 0;
  }

  .project-card__link {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .project-card__link:focus-visible {
    outline: 2px solid var(--color-brand-accent);
    outline-offset: 4px;
    border-radius: var(--ui-radius-lg);
  }

  .project-card__figure {
    position: relative;
    display: grid;
    aspect-ratio: 3 / 2;
    margin: 0;
    overflow: hidden;
    place-items: center;
    border: 1px solid rgb(63 40 35 / 0.12);
    border-radius: var(--ui-radius-lg);
    background: var(--color-surface-container-low);
  }

  .project-card__figure > img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 700ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .project-card__link:hover .project-card__figure > img {
    transform: scale(1.025);
  }

  .project-card__placeholder {
    display: flex;
    width: 100%;
    height: 100%;
    flex-direction: column;
    justify-content: space-between;
    padding: clamp(1.25rem, 4vw, 2.5rem);
    background:
      radial-gradient(ellipse at 80% 15%, rgb(174 112 116 / 0.2), transparent 42%),
      linear-gradient(140deg, #f4eee5, #e9dcd1 58%, #d9c2b7);
    color: var(--color-brand-dark);
  }

  .project-card__placeholder--upcoming {
    background:
      radial-gradient(ellipse at 78% 20%, rgb(174 112 116 / 0.12), transparent 45%),
      linear-gradient(140deg, #f5f1ea, #e8e1d8);
  }

  .project-card__placeholder-label,
  .project-card__placeholder-note {
    font-family: var(--font-sans);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .project-card__placeholder-label {
    color: rgb(63 40 35 / 0.62);
  }

  .project-card__placeholder-title {
    max-width: 16ch;
    font-family: var(--font-heading);
    font-size: clamp(1.7rem, 4vw, 3.4rem);
    font-weight: 600;
    line-height: 1.05;
    text-wrap: balance;
  }

  .project-card__placeholder-note {
    color: rgb(63 40 35 / 0.64);
    letter-spacing: 0.08em;
  }

  .project-card__overlay {
    position: absolute;
    inset: auto 0 0;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    padding: 3.5rem 1.25rem 1.25rem;
    background: linear-gradient(180deg, transparent, rgb(36 24 24 / 0.88));
    color: #fffaf4;
  }

  .project-card__title {
    margin: 0;
    color: inherit;
    font-family: var(--font-heading);
    font-size: clamp(1.2rem, 2.2vw, 1.75rem);
    font-weight: 600;
    line-height: 1.15;
    text-wrap: balance;
  }

  .project-card__category {
    display: block;
    margin-bottom: 0.4rem;
    color: rgb(255 250 244 / 0.8);
    font-family: var(--font-sans);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .project-card__action {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: 0.7rem;
    color: #f1d8cf;
    font-size: 0.83rem;
    font-weight: 600;
  }

  .project-card__status {
    flex: 0 0 auto;
    border: 1px solid rgb(255 250 244 / 0.4);
    border-radius: 999px;
    padding: 0.45rem 0.7rem;
    background: rgb(50 34 34 / 0.35);
    color: #fffaf4;
    font-size: 0.7rem;
    font-weight: 600;
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card__figure > img {
      transition: none;
    }
  }
</style>
