---
import type { projects } from "@data/translation-projects";
import type { NovaLocale } from "@utils/nova-i18n";

interface Props {
  project: (typeof projects)[number];
  locale: NovaLocale;
}

const { project, locale } = Astro.props;
const copy = locale === "pl" ? project.es : project.en;
const languageNames = locale === "pl"
  ? { en: "inglés", es: "español", "es-SV": "español salvadoreño" }
  : { en: "English", es: "Spanish", "es-SV": "Salvadoran Spanish" };
const sourceLanguage = project.direction.length === 2
  ? languageNames[project.direction[0]]
  : locale === "pl" ? "por definir" : "to be determined";
const targetLanguage = project.direction.length === 2
  ? languageNames[project.direction[1]]
  : locale === "pl" ? "por definir" : "to be determined";
const combination = project.direction.length === 2
  ? `${sourceLanguage} → ${targetLanguage}`
  : locale === "pl" ? "Por definir" : "To be determined";
const labels = locale === "pl"
  ? {
      back: "Volver al portafolio",
      area: "Área",
      combination: "Combinación lingüística",
      type: "Especialidad",
      context: "Contexto",
      audience: "Público objetivo",
      objective: "Objetivo de traducción",
      texts: "Texto original y versión traducida",
      original: `Texto original · ${sourceLanguage}`,
      translated: `Traducción · ${targetLanguage}`,
      decisions: "Decisiones lingüísticas",
      visual: "Resultado visual",
      pending: "En desarrollo",
      preparation: "Proyecto en preparación",
      published: "Proyecto en el portafolio",
      imageNote: "Imagen ilustrativa provisional; no representa el resultado de un proyecto final.",
      note: "Nota del proyecto",
    }
  : {
      back: "Back to the portfolio",
      area: "Category",
      combination: "Language direction",
      type: "Specialty",
      context: "Context",
      audience: "Target audience",
      objective: "Translation objective",
      texts: "Source text and translated version",
      original: `Source text · ${sourceLanguage}`,
      translated: `Translation · ${targetLanguage}`,
      decisions: "Linguistic decisions",
      visual: "Visual outcome",
      pending: "In progress",
      preparation: "Project in preparation",
      published: "Project in the portfolio",
      imageNote: "Temporary illustrative image; it does not represent a completed project.",
      note: "Project note",
    };
const homeHref = locale === "pl" ? "/pl/#realizacje" : "/#realizacje";
---

<main class="bg-[var(--ui-bg-page)] text-brand-dark">
  <section class="ui-container pb-12 pt-24 md:pb-16 md:pt-32">
    <div class="mb-6">
      <a href={homeHref} class="inline-flex min-h-11 items-center gap-2 text-sm font-medium tracking-[0.08em] text-brand-dark/70 uppercase transition hover:text-brand-accent">
        <span aria-hidden="true">←</span>
        <span>{labels.back}</span>
      </a>
    </div>
    <div class="grid gap-8 lg:grid-cols-[1.1fr_0.9fr] lg:items-center">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.22em] text-brand-primary/80">{copy.category}</p>
        <h1 class="mt-3 max-w-xl text-4xl font-semibold tracking-tight text-brand-dark md:text-5xl">{copy.title}</h1>
        <p class="mt-3 inline-flex rounded-full border border-brand-dark/15 bg-white/70 px-3 py-1.5 text-xs font-semibold text-brand-dark/75">
          {project.published ? labels.published : labels.preparation}
        </p>
        <div class="mt-6 grid gap-4 sm:grid-cols-3">
          <div class="rounded-2xl border border-brand-dark/10 bg-white/60 p-4 shadow-sm">
            <p class="text-[0.7rem] uppercase tracking-[0.18em] text-brand-dark/50">{labels.area}</p>
            <p class="mt-2 text-sm font-medium text-brand-dark">{copy.category}</p>
          </div>
          <div class="rounded-2xl border border-brand-dark/10 bg-white/60 p-4 shadow-sm">
            <p class="text-[0.7rem] uppercase tracking-[0.18em] text-brand-dark/50">{labels.combination}</p>
            <p class="mt-2 text-sm font-medium text-brand-dark">{combination}</p>
          </div>
          <div class="rounded-2xl border border-brand-dark/10 bg-white/60 p-4 shadow-sm">
            <p class="text-[0.7rem] uppercase tracking-[0.18em] text-brand-dark/50">{labels.type}</p>
            <p class="mt-2 text-sm font-medium text-brand-dark">{copy.type}</p>
          </div>
        </div>
      </div>
      <div class="overflow-hidden rounded-[2rem] border border-brand-dark/10 bg-white shadow-[0_20px_60px_rgba(23,29,42,0.08)]">
        <img src={project.image} alt={copy.imageAlt} class="h-full w-full object-cover" />
        <p class="px-5 py-3 text-xs leading-relaxed text-brand-dark/60">{labels.imageNote}</p>
      </div>
    </div>
  </section>

  <section class="ui-container pb-12 md:pb-16">
    <div class="rounded-[2rem] border border-brand-dark/10 bg-white/80 p-6 md:p-8">
      <h2 class="mb-6 text-sm font-semibold uppercase tracking-[0.2em] text-brand-dark/70">{labels.context}</h2>
      <div class="grid gap-6 md:grid-cols-3">
        <div><h3 class="text-lg font-semibold text-brand-dark">{labels.context}</h3><p class="mt-2 text-brand-dark/75">{copy.context}</p></div>
        <div><h3 class="text-lg font-semibold text-brand-dark">{labels.audience}</h3><p class="mt-2 text-brand-dark/75">{copy.audience}</p></div>
        <div><h3 class="text-lg font-semibold text-brand-dark">{labels.objective}</h3><p class="mt-2 text-brand-dark/75">{copy.objective}</p></div>
      </div>
    </div>
  </section>

  <section class="ui-container pb-12 md:pb-16">
    <h2 class="mb-6 text-sm font-semibold uppercase tracking-[0.2em] text-brand-dark/60">{labels.texts}</h2>
    <div class="grid gap-6 md:grid-cols-2">
      <div class="rounded-[1.5rem] border border-brand-dark/10 bg-white/80 p-6 shadow-sm">
        <h3 class="mb-3 text-xs font-semibold uppercase tracking-[0.18em] text-brand-dark/50">{labels.original}</h3>
        <p class="text-lg leading-relaxed text-brand-dark/80">{project.original}</p>
      </div>
      <div class="rounded-[1.5rem] border border-brand-dark/10 bg-white/80 p-6 shadow-sm">
        <h3 class="mb-3 text-xs font-semibold uppercase tracking-[0.18em] text-brand-dark/50">{labels.translated}</h3>
        <p class="text-lg leading-relaxed text-brand-dark/80">{project.translated}</p>
      </div>
    </div>
  </section>

  <section class="ui-container pb-12 md:pb-16">
    <div class="rounded-[2rem] border border-brand-dark/10 bg-brand-dark px-6 py-7 text-brand-light md:px-8">
      <h2 class="text-sm font-semibold uppercase tracking-[0.2em] text-brand-light/75">{labels.decisions}</h2>
      <ul class="mt-5 space-y-4">
        {copy.decisions.map((decision) => <li class="flex gap-3 text-base leading-relaxed text-brand-light/90"><span class="mt-2 inline-block size-2.5 shrink-0 rounded-full bg-brand-primary" aria-hidden="true"></span><span>{decision}</span></li>)}
      </ul>
    </div>
  </section>

  <section class="ui-container pb-12 md:pb-16">
    <div class="rounded-[2rem] border border-brand-dark/10 bg-white/80 p-6 md:p-8">
      <div class="mb-5 flex items-center gap-2">
        <span class="inline-flex size-2.5 rounded-full bg-brand-accent" aria-hidden="true"></span>
        <h2 class="text-sm font-semibold uppercase tracking-[0.2em] text-brand-dark/70">{labels.visual}</h2>
      </div>
      <div class="rounded-[1.5rem] border border-dashed border-brand-dark/20 bg-[linear-gradient(135deg,rgba(20,48,62,0.05),rgba(227,184,122,0.1))] p-5 md:p-6">
        <p class="text-xs font-semibold uppercase tracking-[0.18em] text-brand-dark/50">{labels.pending}</p>
        <p class="mt-3 text-lg leading-relaxed text-brand-dark">{copy.visual}</p>
      </div>
    </div>
  </section>

  <section class="ui-container pb-16 md:pb-20">
    <p class="rounded-[1.5rem] border border-dashed border-brand-dark/25 bg-brand-dark/5 px-5 py-6 text-sm leading-relaxed text-brand-dark/80 md:px-7">
      <strong class="font-semibold">{labels.note}:</strong> {copy.note}
    </p>
  </section>
</main>
