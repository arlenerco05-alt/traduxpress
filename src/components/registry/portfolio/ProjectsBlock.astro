---
import Section from "@components/ui/layout/Section.astro";
import Container from "@components/ui/layout/Container.astro";
import Heading from "@components/ui/atoms/Heading.astro";
import Text from "@components/ui/atoms/Text.astro";
import ProjectCard from "@components/portfolio/ProjectCard.astro";
import jsonData from "@data/sections/nova-projects.json";
import { ACTIVE_TEMPLATE } from "@config/template";

type Project = {
  category: string;
  categoryKey?: string;
  title: string;
  alt: string;
  slug?: string;
  href?: string;
  previewImage?: string;
  available?: boolean;
};
type ProjectFilter = { key: string; label: string };
interface Props {
  title?: string;
  description?: string;
  linkLabel?: string;
  linkHref?: string;
  items?: Project[];
  filtersLabel?: string;
  filters?: ProjectFilter[];
  actionLabel?: string;
  previewLabel?: string;
  upcomingLabel?: string;
  locale?: "pl" | "en";
  class?: string;
}

const props = Astro.props as Props;
const fallback = ACTIVE_TEMPLATE === "nova" ? undefined : jsonData;
const title = props.title ?? fallback?.title;
const description = props.description ?? fallback?.description;
const linkLabel = props.linkLabel ?? fallback?.linkLabel;
const linkHref = props.linkHref ?? fallback?.linkHref;
const fallbackItems: Project[] = (fallback?.items ?? []).map((item) => ({
  ...item,
  categoryKey: "",
  available: true,
}));
const items = props.items ?? fallbackItems;
const filters = props.filters ?? [];
const locale = props.locale ?? "pl";
const actionLabel = props.actionLabel ?? (locale === "en" ? "View project" : "Ver proyecto");
const previewLabel = props.previewLabel ?? (locale === "en" ? "Visual sample pending" : "Muestra visual pendiente");
const upcomingLabel = props.upcomingLabel ?? (locale === "en" ? "Coming soon" : "Próximamente");
const getProjectHref = (item: Project) => item.href ?? (
  item.slug ? `${locale === "en" ? "/projects" : "/proyectos"}/${item.slug}/` : linkHref ?? "#"
);
---

<Section id="realizacje" tone="page" class:list={["relative z-[1] -mt-4 rounded-t-[var(--rounded-lg)] pb-16", props.class]}>
  <Container class="w-full max-w-none px-[clamp(1.5rem,5vw,5rem)]">
    <div class="projects-intro">
      <Heading tag="h2" variant="section-title">{title}</Heading>
      <div class="projects-intro__copy">
        <Text variant="lead">{description}</Text>
        <a class="projects-link group" href={linkHref}>
          <span>{linkLabel}</span>
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>

    <div data-project-section>
      {filters.length > 0 && (
        <div class="projects-filters" role="group" aria-label={props.filtersLabel} data-project-filters>
          {filters.map((filter, index) => (
            <button
              type="button"
              class="projects-filter"
              data-project-filter={filter.key}
              aria-pressed={index === 0 ? "true" : "false"}
            >
              {filter.label}
            </button>
          ))}
        </div>
      )}

      <div class="projects-grid" data-project-grid>
        {items.map((item) => (
          <div data-project-card data-project-category={item.categoryKey ?? ""}>
            <ProjectCard
              title={item.title}
              category={item.category}
              alt={item.alt}
              href={getProjectHref(item)}
              available={item.available !== false}
              previewImage={item.previewImage}
              actionLabel={actionLabel}
              previewLabel={previewLabel}
              upcomingLabel={upcomingLabel}
            />
          </div>
        ))}
      </div>
    </div>
  </Container>
</Section>

<script>
  document.addEventListener("click", (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;

    const button = target.closest<HTMLButtonElement>("[data-project-filter]");
    if (!button) return;

    const section = button.closest("[data-project-section]");
    const group = button.closest("[data-project-filters]");
    const grid = section?.querySelector("[data-project-grid]");
    if (!section || !group || !grid) return;

    const selectedCategory = button.dataset.projectFilter;
    group.querySelectorAll<HTMLButtonElement>("[data-project-filter]").forEach((filterButton) => {
      filterButton.setAttribute("aria-pressed", filterButton === button ? "true" : "false");
    });

    grid.querySelectorAll<HTMLElement>("[data-project-card]").forEach((card) => {
      card.hidden = selectedCategory !== "all" && card.dataset.projectCategory !== selectedCategory;
    });
  });
</script>

<style>
  .projects-intro {
    display: grid;
    gap: 1.5rem;
  }

  .projects-intro__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
  }

  .projects-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--color-brand-dark);
    text-decoration: none;
    transition: color 180ms ease;
  }

  .projects-link:hover,
  .projects-link:focus-visible {
    color: var(--color-brand-accent);
  }

  .projects-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 2rem;
  }

  .projects-filter {
    min-height: 2.75rem;
    border: 1px solid rgb(63 40 35 / 0.2);
    border-radius: 9999px;
    padding: 0.6rem 1rem;
    background: transparent;
    color: var(--color-brand-dark);
    font: inherit;
    font-size: 0.875rem;
    cursor: pointer;
    transition: color 180ms ease, background-color 180ms ease, border-color 180ms ease;
  }

  .projects-filter:hover,
  .projects-filter[aria-pressed="true"] {
    border-color: var(--color-brand-dark);
    background: var(--color-brand-dark);
    color: var(--color-surface);
  }

  .projects-filter:focus-visible {
    outline: 2px solid var(--color-brand-accent);
    outline-offset: 3px;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.25rem;
    margin-top: 1.5rem;
  }

  .projects-grid > [hidden] {
    display: none !important;
  }

  @media (min-width: 48rem) {
    .projects-intro {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 2.75rem;
    }

    .projects-intro__copy {
      align-items: flex-end;
      text-align: right;
    }

    .projects-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.5rem;
    }
  }

  @media (min-width: 80rem) {
    .projects-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .projects-filter,
    .projects-link {
      transition: none;
    }
  }
</style>
