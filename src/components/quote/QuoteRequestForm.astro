---
import { getNovaCopy, getNovaNavigationPath, type NovaLocale } from "@utils/nova-i18n";

interface Props {
  locale: NovaLocale;
}

const { locale } = Astro.props;
const copy = getNovaCopy(locale);
const quote = copy.quote;
const services = copy.sections["nova-services"].items;
const serviceValues = ["translation", "localization", "proofreading", "subtitling", "advertising"] as const;
const privacyHref = getNovaNavigationPath("/polityka-prywatnosci/", locale, Astro.url.pathname);
---

<form
  class="quote-form"
  action="/api/quote"
  method="POST"
  data-quote-form
  data-message-success={quote.success}
  data-message-error={quote.error}
  data-message-not-configured={quote.notConfigured}
>
  <div class="quote-form__feedback" data-quote-feedback role="status" aria-live="polite" tabindex="-1" hidden></div>

  <div class="quote-form__grid">
    <div class="quote-form__field">
      <label for={`quote-name-${locale}`}>{quote.fields.name} <span aria-hidden="true">*</span></label>
      <input id={`quote-name-${locale}`} name="name" type="text" autocomplete="name" maxlength="120" required />
    </div>

    <div class="quote-form__field">
      <label for={`quote-email-${locale}`}>{quote.fields.email} <span aria-hidden="true">*</span></label>
      <input id={`quote-email-${locale}`} name="email" type="email" autocomplete="email" maxlength="254" required />
    </div>

    <div class="quote-form__field">
      <label for={`quote-service-${locale}`}>{quote.fields.service} <span aria-hidden="true">*</span></label>
      <select id={`quote-service-${locale}`} name="service" required>
        <option value="" selected disabled>{quote.fields.servicePlaceholder}</option>
        {services.map((service, index) => (
          <option value={serviceValues[index]}>{service.title}</option>
        ))}
      </select>
    </div>

    <div class="quote-form__field">
      <label for={`quote-language-${locale}`}>{quote.fields.language} <span aria-hidden="true">*</span></label>
      <select id={`quote-language-${locale}`} name="language" required>
        <option value="" selected disabled>{quote.fields.languagePlaceholder}</option>
        <option value="en-es">{quote.languages["en-es"]}</option>
        <option value="es-en">{quote.languages["es-en"]}</option>
        <option value="other">{quote.languages.other}</option>
      </select>
    </div>

    <div class="quote-form__field">
      <label for={`quote-deadline-${locale}`}>{quote.fields.deadline}</label>
      <input id={`quote-deadline-${locale}`} name="deadline" type="date" />
    </div>

    <div class="quote-form__field quote-form__field--wide">
      <label for={`quote-description-${locale}`}>{quote.fields.description} <span aria-hidden="true">*</span></label>
      <textarea
        id={`quote-description-${locale}`}
        name="description"
        rows="6"
        maxlength="5000"
        placeholder={quote.fields.descriptionPlaceholder}
        required
      ></textarea>
    </div>
  </div>

  <div class="quote-form__honeypot" aria-hidden="true">
    <label for={`quote-website-${locale}`}>Leave this field empty</label>
    <input id={`quote-website-${locale}`} name="website" type="text" tabindex="-1" autocomplete="off" />
  </div>

  <p class="quote-form__privacy">
    {quote.privacy.replace(quote.privacyLink, "")}
    <a href={privacyHref}>{quote.privacyLink}</a>.
  </p>

  <button class="quote-form__submit" type="submit" data-submit-label={quote.submit} data-sending-label={quote.sending}>
    {quote.submit}
  </button>
</form>

<script>
  type QuoteResponse = {
    status?: string;
    code?: string;
  };

  const bindQuoteForms = () => document.querySelectorAll<HTMLFormElement>("[data-quote-form]").forEach((form) => {
    if (form.dataset.bound === "true") return;
    form.dataset.bound = "true";

    const feedback = form.querySelector<HTMLElement>("[data-quote-feedback]");
    const submit = form.querySelector<HTMLButtonElement>('[type="submit"]');
    if (!feedback || !submit) return;

    const originalLabel = submit.dataset.submitLabel ?? submit.textContent ?? "";
    const sendingLabel = submit.dataset.sendingLabel ?? originalLabel;
    const messages = {
      success: form.dataset.messageSuccess ?? "",
      error: form.dataset.messageError ?? "",
      notConfigured: form.dataset.messageNotConfigured ?? "",
    };

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;

      feedback.hidden = true;
      submit.disabled = true;
      submit.textContent = sendingLabel;

      try {
        const response = await fetch(form.action, {
          method: "POST",
          headers: { "Content-Type": "application/json", Accept: "application/json" },
          body: JSON.stringify(Object.fromEntries(new FormData(form).entries())),
        });

        const result = await response.json().catch((): QuoteResponse => ({})) as QuoteResponse;
        if (!response.ok || result.status !== "ok") {
          feedback.textContent = result.code === "not_configured" ? messages.notConfigured : messages.error;
          feedback.dataset.state = "error";
          feedback.hidden = false;
          feedback.focus();
          return;
        }

        form.reset();
        feedback.textContent = messages.success;
        feedback.dataset.state = "success";
        feedback.hidden = false;
        feedback.focus();
      } catch {
        feedback.textContent = messages.error;
        feedback.dataset.state = "error";
        feedback.hidden = false;
        feedback.focus();
      } finally {
        submit.disabled = false;
        submit.textContent = originalLabel;
      }
    });
  });

  bindQuoteForms();
  document.addEventListener("astro:page-load", bindQuoteForms);
</script>

<style>
  .quote-form {
    --quote-ink: #3f2823;
    --quote-wine: #5c303b;
    color: var(--quote-ink);
  }

  .quote-form__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.15rem;
  }

  .quote-form__field {
    display: grid;
    min-width: 0;
    gap: 0.5rem;
  }

  .quote-form__field label {
    font-size: 0.88rem;
    font-weight: 600;
  }

  .quote-form__field label span {
    color: var(--quote-wine);
  }

  .quote-form__field input,
  .quote-form__field select,
  .quote-form__field textarea {
    width: 100%;
    min-height: 3rem;
    border: 1px solid rgb(63 40 35 / 0.2);
    border-radius: 0.75rem;
    padding: 0.75rem 0.9rem;
    background: #fffdf9;
    color: var(--quote-ink);
    font: inherit;
  }

  .quote-form__field textarea {
    min-height: 10rem;
    resize: vertical;
  }

  .quote-form__field input:focus-visible,
  .quote-form__field select:focus-visible,
  .quote-form__field textarea:focus-visible {
    border-color: var(--quote-wine);
    outline: 2px solid rgb(92 48 59 / 0.22);
    outline-offset: 1px;
  }

  .quote-form__privacy {
    margin: 1.25rem 0;
    color: rgb(63 40 35 / 0.7);
    font-size: 0.84rem;
    line-height: 1.6;
  }

  .quote-form__privacy a {
    color: var(--quote-wine);
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .quote-form__submit {
    min-height: 3rem;
    border: 1px solid var(--quote-wine);
    border-radius: 999px;
    padding: 0.75rem 1.4rem;
    background: var(--quote-wine);
    color: #fffaf4;
    font: inherit;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 180ms ease, color 180ms ease;
  }

  .quote-form__submit:hover:not(:disabled) {
    background: transparent;
    color: var(--quote-wine);
  }

  .quote-form__submit:focus-visible {
    outline: 2px solid var(--quote-wine);
    outline-offset: 3px;
  }

  .quote-form__submit:disabled {
    cursor: wait;
    opacity: 0.7;
  }

  .quote-form__feedback {
    margin-bottom: 1.25rem;
    border-radius: 0.85rem;
    padding: 0.9rem 1rem;
    line-height: 1.55;
  }

  .quote-form__feedback[data-state="success"] {
    background: #e7efe6;
    color: #284a31;
  }

  .quote-form__feedback[data-state="error"] {
    background: #f5e5e1;
    color: #642f2a;
  }

  .quote-form__honeypot {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  @media (min-width: 40rem) {
    .quote-form__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.25rem;
    }

    .quote-form__field--wide {
      grid-column: 1 / -1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .quote-form__submit {
      transition: none;
    }
  }
</style>
