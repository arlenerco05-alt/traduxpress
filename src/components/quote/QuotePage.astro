---
import { getNovaCopy, getNovaNavigationPath, type NovaLocale } from "@utils/nova-i18n";
import QuoteRequestForm from "./QuoteRequestForm.astro";

interface Props {
  locale: NovaLocale;
}

const { locale } = Astro.props;
const copy = getNovaCopy(locale);
const quote = copy.quote;
const homeHref = getNovaNavigationPath("/", locale, Astro.url.pathname);
---

<main class="quote-page">
  <section class="ui-container quote-page__content">
    <a class="quote-page__back" href={homeHref}>{quote.back}</a>
    <p class="quote-page__eyebrow">TraduXpress</p>
    <h1>{quote.title}</h1>
    <p class="quote-page__subtitle">{quote.subtitle}</p>
    <div class="quote-page__panel">
      <QuoteRequestForm locale={locale} />
    </div>
  </section>
</main>

<style>
  .quote-page {
    background:
      radial-gradient(ellipse at 85% 8%, rgb(174 112 116 / 0.12), transparent 32%),
      #f7f1e9;
    color: #3f2823;
  }

  .quote-page__content {
    max-width: 56rem;
    padding-top: clamp(7rem, 13vw, 10rem);
    padding-bottom: clamp(4rem, 8vw, 7rem);
  }

  .quote-page__back {
    color: rgb(63 40 35 / 0.72);
    font-size: 0.88rem;
    text-decoration: none;
  }

  .quote-page__back:hover,
  .quote-page__back:focus-visible {
    color: #5c303b;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .quote-page__eyebrow {
    margin: 2rem 0 0.65rem;
    color: #5c303b;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .quote-page h1 {
    margin: 0;
    font-family: var(--font-heading);
    font-size: clamp(2.35rem, 7vw, 4.8rem);
    font-weight: 500;
    letter-spacing: -0.04em;
    line-height: 1;
    text-wrap: balance;
  }

  .quote-page__subtitle {
    max-width: 42rem;
    margin: 1rem 0 2rem;
    color: rgb(63 40 35 / 0.72);
    font-size: clamp(1rem, 2vw, 1.2rem);
    line-height: 1.65;
  }

  .quote-page__panel {
    border: 1px solid rgb(63 40 35 / 0.1);
    border-radius: 1.5rem;
    padding: clamp(1.15rem, 4vw, 2.25rem);
    background: rgb(255 255 255 / 0.62);
    box-shadow: 0 1.5rem 4rem rgb(63 40 35 / 0.06);
  }
</style>
